# Instagram Simulator - Agent Configuration
# ==========================================
# Configure your API keys and model settings here

# General API Configuration (fallback)
API_KEY=your_api_key_here
API_BASE=https://api.openai.com/v1
MODEL_NAME=gpt-4o

# GPT-4o Configuration
GPT4O_API_KEY=your_gpt4o_api_key
GPT4O_API_BASE=https://api.openai.com/v1
GPT4O_MODEL_NAME=gpt-4o

# GPT-5 Configuration
GPT5_API_KEY=your_gpt5_api_key
GPT5_API_BASE=https://api.openai.com/v1
GPT5_MODEL_NAME=gpt-5

# Gemini 2.5 Pro Configuration
GEMINI25_PRO_API_KEY=your_gemini_api_key
GEMINI25_PRO_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI25_PRO_MODEL_NAME=gemini-2.5-pro

# Claude 4.5 Sonnet Configuration
CLAUDE45_SONNET_API_KEY=your_claude_api_key
CLAUDE45_SONNET_API_BASE=https://api.anthropic.com/v1
CLAUDE45_SONNET_MODEL_NAME=claude-4.5-sonnet

# Claude 3.5 Sonnet Configuration
CLAUDE35_SONNET_API_KEY=your_claude_api_key
CLAUDE35_SONNET_API_BASE=https://api.anthropic.com/v1
CLAUDE35_SONNET_MODEL_NAME=claude-3-5-sonnet-20241022

# Agent Settings
MAX_STEPS=15
TIMEOUT=300
